{
  "name": "Notify Users When Contest Finishes",
  "description": "Automatski \u0161alje notifikaciju svim sudionicima natjecanja kada ono zavr\u0161i (status \u2192 finished)",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"finished\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_users_when_contest_finishes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyContestFinished",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyContestFinished"
  }
}